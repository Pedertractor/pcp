generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Unit {
  PEDERTRACTOR
  TRACTOR

  @@map("unit")
}

enum UserRole {
  ADMIN
  PCP_OPERATOR

  @@map("user_role")
}

model User {
  id         Int       @id @default(autoincrement())
  email      String?   @unique
  cardNumber String    @map("card_number")
  unit       Unit
  password   String
  employeeId Int       @unique @map("employee_id")
  name       String?
  firstLogin Boolean   @default(true) @map("first_login")
  status     Boolean   @default(true)
  role       UserRole  @default(PCP_OPERATOR)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  refreshTokens RefreshToken[]

  @@unique([cardNumber, unit])
  @@map("users")
}

model RefreshToken {
  id           String        @id @default(uuid())
  userId       Int           @map("user_id")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String        @unique @map("token_hash")
  familyId     String        @map("family_id")
  expiresAt    DateTime      @map("expires_at")
  revokedAt    DateTime?     @map("revoked_at")
  replacedById String?       @unique @map("replaced_by_id")
  replacedBy   RefreshToken? @relation("RefreshRotation", fields: [replacedById], references: [id])
  predecessor  RefreshToken? @relation("RefreshRotation")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

enum BlockSector {
  PAINT

  @@map("block_sector")
}

enum ProductionOrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE

  @@map("production_order_status")
}

model BlockPlanImage {
  id           String   @id @default(uuid())
  name         String
  originalName String?  @map("original_name")
  url          String
  mimeType     String?  @map("mime_type")
  size         Int?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  block Block?

  @@map("block_plan_images")
}

model Block {
  id               String      @id @default(uuid())
  name             String      @unique
  sector           BlockSector @default(PAINT)
  blockPlanImageId String?     @unique @map("block_plan_image_id")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  blockPlanImage   BlockPlanImage?   @relation(fields: [blockPlanImageId], references: [id], onDelete: SetNull)
  costCenters      CostCenter[]
  lines            Line[]
  machines         Machine[]
  productionOrders ProductionOrder[]
  productionProcesses ProductionProcess[]
  paintColorLinks  BlockPaintColor[]

  @@map("blocks")
}

model CostCenter {
  id              String  @id @default(uuid())
  costCenter      String  @unique @map("cost_center")
  sectorName      String  @map("sector_name")
  sectorIdBaseApi String  @unique @map("sector_id_base_api")
  blockId         String  @map("block_id")

  block Block @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId])
  @@map("cost_centers")
}

model PaintColor {
  id          String  @id @default(uuid())
  name        String
  nameKey     String  @unique(map: "paint_colors_name_key_key") @map("name_key")
  baseColorId String? @map("base_color_id")
  brand       String?

  productionOrders ProductionOrder[]
  productionProcesses ProductionProcess[]
  blockLinks       BlockPaintColor[]

  @@map("paint_colors")
}

/// Cor de mapa vinculada ao bloco (hex #RRGGBB) para exibir na planta.
model BlockPaintColor {
  id      String @id @default(uuid())
  blockId String @map("block_id")
  colorId String @map("color_id")
  mapHex  String @map("map_hex")

  block Block      @relation(fields: [blockId], references: [id], onDelete: Cascade)
  color PaintColor @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@unique([blockId, colorId])
  @@index([colorId])
  @@map("block_paint_colors")
}

enum LineLabelAnchor {
  TOP_LEFT
  TOP_RIGHT
  BOTTOM_LEFT
  BOTTOM_RIGHT

  @@map("line_label_anchor")
}

model Line {
  id             String           @id @default(uuid())
  blockId        String           @map("block_id")
  code           String
  positionX      Float?           @map("position_x")
  positionY      Float?           @map("position_y")
  positionWidth  Float?           @map("position_width")
  positionHeight Float?           @map("position_height")
  labelAnchor    LineLabelAnchor  @default(TOP_LEFT) @map("label_anchor")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  block    Block     @relation(fields: [blockId], references: [id], onDelete: Cascade)
  machines Machine[]

  @@unique([blockId, code])
  @@index([blockId])
  @@map("lines")
}

model Machine {
  id         String  @id @default(uuid())
  code       String  @unique
  costCenter String? @map("cost_center")
  positionX  Float?  @map("position_x")
  positionY  Float?  @map("position_y")
  positionWidth  Float? @map("position_width")
  positionHeight Float? @map("position_height")
  labelAnchor    LineLabelAnchor @default(BOTTOM_LEFT) @map("label_anchor")
  blockId    String  @map("block_id")
  lineId     String? @map("line_id")

  block            Block             @relation(fields: [blockId], references: [id], onDelete: Restrict)
  line             Line?             @relation(fields: [lineId], references: [id], onDelete: SetNull)
  productionOrders ProductionOrder[]
  productionProcesses ProductionProcess[]

  @@index([blockId])
  @@index([lineId])
  @@map("machines")
}

model ProductionOrder {
  id          String                @id @default(uuid())
  ofNumber    String                @map("of_number")
  partCode    String                @map("part_code")
  blockId     String                @map("block_id")
  line        String
  colorId     String?               @map("color_id")
  /// Área de uma peça em m² (coluna AREA). Área da OF = area * quantity.
  area        Float?
  direction   String?
  operation   String?
  costCenter  String?               @map("cost_center")
  statusDate  String?               @map("status_date")
  machineId   String?               @map("machine_id")
  quantity    Int                   @default(0)
  targetDate  DateTime              @map("target_date")
  /// Data da última sincronização de planejamento que trouxe a OF.
  syncDate    DateTime              @map("sync_date")
  status      ProductionOrderStatus @default(PENDING)
  completedAt DateTime?             @map("completed_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  block   Block       @relation(fields: [blockId], references: [id], onDelete: Restrict)
  color   PaintColor? @relation(fields: [colorId], references: [id], onDelete: SetNull)
  machine Machine?    @relation(fields: [machineId], references: [id], onDelete: SetNull)
  processes ProductionProcess[]

  /// A OF não se repete dentro do bloco; a mesma OF pode existir em outro bloco.
  @@unique([blockId, ofNumber])
  @@index([blockId])
  @@index([status])
  @@map("production_orders")
}

/// Processo de execução retornado pela consulta de acompanhamento (a cada 5 min).
/// Espelha o payload da API; uma OF pode ter um processo por operação (chave OF + OP no bloco).
model ProductionProcess {
  id                String    @id @default(uuid())
  productionOrderId String    @map("production_order_id")
  blockId           String    @map("block_id")
  ofNumber          String    @map("of_number")

  opNumber          Int       @map("op_number")
  costCenter        String    @map("cost_center")
  plannedAt         DateTime? @map("planned_at")
  quantity          Int       @default(0)
  quantityReported  Int?      @map("quantity_reported")
  startedAt         DateTime? @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  badgeNumber       Int?      @map("badge_number")
  componentCode     Int?      @map("component_code")
  componentQuantity Int?      @map("component_quantity")
  machineCode       String    @map("machine_code")
  machineId         String?   @map("machine_id")
  /// Nome da cor vindo da consulta de processos (mapa usa quando há início no dia — seção 4 e 5).
  colorName         String?   @map("color_name")
  colorId           String?   @map("color_id")
  /// m² por peça (string na API; persistido como número).
  area              Float?

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  block           Block           @relation(fields: [blockId], references: [id], onDelete: Cascade)
  machine         Machine?        @relation(fields: [machineId], references: [id], onDelete: SetNull)
  color           PaintColor?     @relation(fields: [colorId], references: [id], onDelete: SetNull)

  @@unique([productionOrderId, opNumber])
  @@index([blockId, startedAt])
  @@index([blockId, finishedAt])
  @@index([machineId])
  @@map("production_processes")
}

// ---------------------------------------------------------------------------
// PMP — Plano Mestre de Produção (domínio separado do Block do Controle Produtivo)
// ---------------------------------------------------------------------------

/// Imagem temática do bloco PMP (fundo transparente; PNG ou WEBP).
model PmpBlockThemeImage {
  id           String   @id @default(uuid())
  name         String
  originalName String?  @map("original_name")
  url          String
  mimeType     String?  @map("mime_type")
  size         Int?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  pmpBlock PmpBlock?

  @@map("pmp_block_theme_images")
}

/// Agrupamento organizacional do PMP; cada bloco concentra CCs, operações e metas semanais.
model PmpBlock {
  id           String   @id @default(uuid())
  name         String   @unique
  themeImageId String?  @unique @map("theme_image_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  themeImage  PmpBlockThemeImage? @relation(fields: [themeImageId], references: [id], onDelete: SetNull)
  costCenters PmpCostCenter[]
  series      PmpSeries[]
  weeklyGoals ProductionWeeklyGoal[]

  @@map("pmp_blocks")
}

/// Série de peças do bloco PMP; o bloco só aceita metas cujo `productCode` está em alguma série dele.
model PmpSeries {
  id         String   @id @default(uuid())
  pmpBlockId String   @map("pmp_block_id")
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  pmpBlock PmpBlock        @relation(fields: [pmpBlockId], references: [id], onDelete: Cascade)
  parts    PmpSeriesPart[]

  @@unique([pmpBlockId, name])
  @@index([pmpBlockId])
  @@map("pmp_series")
}

/// Peça + operação de uma série; juntos formam o CONCATENAR da planilha (ex.: 248868 + 30 = 24886830).
model PmpSeriesPart {
  id          String   @id @default(uuid())
  pmpSeriesId String   @map("pmp_series_id")
  partCode    String   @map("part_code")
  operation   Int
  createdAt   DateTime @default(now()) @map("created_at")

  pmpSeries PmpSeries @relation(fields: [pmpSeriesId], references: [id], onDelete: Cascade)

  @@unique([pmpSeriesId, partCode, operation])
  @@index([partCode])
  @@map("pmp_series_parts")
}

/// Centro de custo vinculado a um bloco PMP; `sectorIdApi` identifica o setor na API externa.
model PmpCostCenter {
  id           String  @id @default(uuid())
  pmpBlockId   String  @map("pmp_block_id")
  costCenter   String  @map("cost_center")
  sectorName   String? @map("sector_name")
  sectorIdApi  String  @map("sector_id_api")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pmpBlock    PmpBlock               @relation(fields: [pmpBlockId], references: [id], onDelete: Cascade)
  weeklyGoals ProductionWeeklyGoal[]

  @@unique([pmpBlockId, costCenter])
  @@unique([pmpBlockId, sectorIdApi])
  @@index([pmpBlockId])
  @@map("pmp_cost_centers")
}

/// A operação vem do CONCATENAR da classe do bloco (código da peça + operação).
model ProductionWeeklyGoal {
  id              String @id @default(uuid())
  pmpBlockId      String @map("pmp_block_id")
  pmpCostCenterId String @map("pmp_cost_center_id")
  operation       Int

  productCode     String  @map("product_code")
  productName     String? @map("product_name")

  weekStart DateTime @map("week_start") @db.Date
  weekEnd   DateTime @map("week_end") @db.Date

  plannedQuantity  Int @map("planned_quantity")
  producedQuantity Int @default(0) @map("produced_quantity")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pmpBlock      PmpBlock              @relation(fields: [pmpBlockId], references: [id], onDelete: Cascade)
  pmpCostCenter PmpCostCenter         @relation(fields: [pmpCostCenterId], references: [id], onDelete: Restrict)
  dailyGoals    ProductionDailyGoal[]

  @@unique([pmpBlockId, productCode, pmpCostCenterId, operation, weekStart])
  @@index([weekStart, pmpCostCenterId])
  @@index([pmpBlockId, weekStart])
  @@map("production_weekly_goals")
}

model ProductionDailyGoal {
  id               String   @id @default(uuid())
  weeklyGoalId     String   @map("weekly_goal_id")

  date             DateTime @db.Date
  plannedQuantity  Int      @map("planned_quantity")
  producedQuantity Int      @default(0) @map("produced_quantity")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  weeklyGoal    ProductionWeeklyGoal       @relation(fields: [weeklyGoalId], references: [id], onDelete: Cascade)
  orders        ProductionDailyGoalOrder[]
  loansGiven    ProductionGoalLoan[]       @relation("LoanSource")
  loansReceived ProductionGoalLoan[]       @relation("LoanTarget")

  @@unique([weeklyGoalId, date])
  @@index([date])
  @@map("production_daily_goals")
}

model ProductionDailyGoalOrder {
  id          String @id @default(uuid())
  dailyGoalId String @map("daily_goal_id")

  externalOrderId   String @map("external_order_id")
  operation         Int
  allocatedQuantity Int    @map("allocated_quantity")
  producedQuantity  Int    @default(0) @map("produced_quantity")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dailyGoal ProductionDailyGoal @relation(fields: [dailyGoalId], references: [id], onDelete: Cascade)

  @@unique([dailyGoalId, externalOrderId, operation])
  @@index([externalOrderId, operation])
  @@map("production_daily_goal_orders")
}

model ProductionGoalLoan {
  id                String @id @default(uuid())
  sourceDailyGoalId String @map("source_daily_goal_id")
  targetDailyGoalId String @map("target_daily_goal_id")

  sourceOrderId    String @map("source_order_id")
  borrowedQuantity Int    @map("borrowed_quantity")

  createdAt DateTime @default(now()) @map("created_at")

  sourceDailyGoal ProductionDailyGoal @relation("LoanSource", fields: [sourceDailyGoalId], references: [id], onDelete: Restrict)
  targetDailyGoal ProductionDailyGoal @relation("LoanTarget", fields: [targetDailyGoalId], references: [id], onDelete: Restrict)

  @@index([sourceDailyGoalId])
  @@index([targetDailyGoalId])
  @@index([sourceOrderId])
  @@map("production_goal_loans")
}
